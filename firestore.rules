rules_version = '2';

// Reglas de la base de datos en la nube de El Impostor.
// Cada perfil está en usuarios/{uid} y solo su dueño (logueado con Google) puede escribirlo.
// El ranking es público: cualquiera puede leer nombres, personajes y puntos.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid} {
      function esDueno() { return request.auth != null && request.auth.uid == uid; }
      function valido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['nombre', 'look', 'puntos', 'racha', 'mejorRacha', 'stats', 'logros', 'historial', 'contadas', 'creado', 'actualizado'])
          && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 16
          && d.puntos is number && d.puntos >= 0
          && d.historial is list && d.historial.size() <= 40
          && d.contadas is list && d.contadas.size() <= 100;
      }

      allow read: if true;
      allow create: if esDueno() && valido() && request.resource.data.puntos == 0;
      // Los puntos nunca bajan y no pueden subir de golpe (evita trampas obvias)
      allow update: if esDueno() && valido()
        && request.resource.data.puntos >= resource.data.puntos
        && request.resource.data.puntos <= resource.data.puntos + 500;
      allow delete: if esDueno();
    }
  }
}
